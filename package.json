{
  "name": "claufy",
  "version": "0.1.0",
  "private": true,
  "description": "Every window you're working in, on one screen. Open terminals and pages as tiles that space themselves, and the one you're using grows.",
  "license": "MIT",
  "author": "Vedhith Krishnakumar",
  "homepage": "https://claufy.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/kk-vp/claufy.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "node scripts/fix-pty-perms.mjs",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/make-icons.mjs",
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist": "npm run build && npm run icons && electron-builder --dir",
    "dist:release": "npm run build && npm run icons && electron-builder",
    "install-app": "node scripts/install-app.mjs",
    "site": "node scripts/serve.mjs"
  },
  "build": {
    "appId": "dev.vedhith.claufy",
    "productName": "Claufy",
    "directories": {
      "output": "release"
    },
    "artifactName": "Claufy-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon-256.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/node": "^22.10.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "sharp": "^0.33.5",
    "typescript": "^5.7.0"
  }
}
